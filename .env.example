# ADRESSE IP d'écoute. 0.0.0.0 autorise les ordinateurs du réseau local. Utiliser 127.0.0.1 pour tests locaux.
LISTEN_HOST=0.0.0.0
# Port TCP où Printr envoie son flux brut ESC/POS. Ne pas démarrer emupos sur ce même port en parallèle.
LISTEN_PORT=9100

# Transport de sortie : dry-run (aucun papier), usb (connu fonctionnel), bluetooth-rfcomm (port série), bluetooth-socket (RFCOMM Python).
# Premier lancement conseillé : dry-run. Pour imprimer ensuite : usb.
TRANSPORT=dry-run
# Forcer un aperçu sans transfert matériel même si TRANSPORT vaut usb ou bluetooth-* : true/false.
DRY_RUN=false
# Chemin de la T003 reconnue par Linux ; validé lors de nos tests sur Pi Zero W.
USB_DEVICE=/dev/usb/lp0
# Dispositif RFCOMM créé avec BlueZ/rfcomm (seulement pour bluetooth-rfcomm).
BLUETOOTH_DEVICE=/dev/rfcomm0
# Adresse Bluetooth classique de la T003 (AA:BB:CC:DD:EE:FF). À relever par bluetoothctl ; pas le nom T003-FD96.
BLUETOOTH_ADDRESS=
# Canal RFCOMM SPP, à déterminer avec sdptool browse (souvent 1, NON confirmé T003).
BLUETOOTH_CHANNEL=1

# Largeur utile mesurée : 576 pixels sur rouleau 80 mm ; ne pas confondre avec la largeur physique.
PRINT_WIDTH=576
# Largeur de rouleau déclarée dans SIZE TSPL ; valeur physique du rouleau utilisé.
PAPER_WIDTH_MM=80
# Résolution de la tête thermique : 203 dpi sur notre T003.
DPI=203
# Nombre max de lignes par page TSPL. 600 validé ; <= 832 testé en bitmap unique.
BAND_HEIGHT=600
# Recul entre deux pages, exprimé en points entiers. Valeur finale choisie après calibration : 13.
BACKFEED=13
# Binarisation : noir si valeur de gris < 180 ; 0 = presque tout blanc, 255 = plus de noir.
THRESHOLD=180
# Tramage : threshold (recommandé pour traits/texte) ou floyd (utile pour photos).
DITHER=threshold
# Police TTF locale utilisée pour reconstruire le texte ESC/POS ; adapter si besoin.
FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf
# Taille du texte en pixels (base ; les commandes ESC/POS peuvent doubler la taille).
FONT_SIZE=22
# Nombre de caractères par ligne visé pour un ticket 80mm ; paramètre de référence.
CHARS_PER_LINE=42

# Taille maximale d'un travail entrant (octets), pour éviter de saturer le Pi Zero.
MAX_JOB_BYTES=4194304
# Hauteur maximale de l'image produite, en pixels, pour éviter de saturer la mémoire.
MAX_IMAGE_HEIGHT=12000
# Secondes sans nouvelles données TCP avant de considérer le travail terminé ; augmenter si Printr transmet lentement.
JOB_IDLE_TIMEOUT=2
# Répertoire des images et des éventuelles captures brutes (chemin absolu conseillé en service).
SPOOL_DIR=./spool
# Sauvegarde du flux ESC/POS original pour diagnostic : false par défaut (contient potentiellement du texte privé).
SAVE_RAW=false
# Conserver un PNG aperçu de chaque ticket ; désactiver si confidentialité ou espace disque limité.
SAVE_PNG=true
# Rejeter un ticket si une commande ESC/POS n'est pas gérée. Recommandé pour ne pas imprimer des tickets incomplets.
STRICT_ESCPOS=true
